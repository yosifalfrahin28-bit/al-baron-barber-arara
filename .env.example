# Shared backend database. Use a pooled PostgreSQL URL from Neon or Supabase.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# API server
NODE_ENV=production
PORT=8080
FRONTEND_ORIGIN=https://your-project.vercel.app

# WhatsApp / Baileys
# Keep this true only when the host has persistent storage or a database-backed auth store.
WHATSAPP_ENABLED=true
WHATSAPP_AUTH_DIR=/var/lib/al-baron/whatsapp-auth

# Vite frontend build (Vercel/Netlify). Leave blank for same-origin Replit routing.
VITE_API_BASE_URL=https://your-api-service.example.com